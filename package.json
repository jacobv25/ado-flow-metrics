{
  "name": "ado-flow-metrics",
  "version": "2.0.0",
  "description": "Flow metrics for Azure DevOps teams: WIP aging, PR aging, throughput, cycle time, and Monte Carlo delivery forecasting. Local, PAT stays server-side.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "demo": "DEMO_MODE=true node server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "vitest run && playwright test"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "vitest": "^3.2.7"
  }
}
