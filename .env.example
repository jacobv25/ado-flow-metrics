# ─── Azure DevOps connection ───────────────────────────────────────────────────
# Your Azure DevOps organisation URL (no trailing slash).
# Examples:
#   https://dev.azure.com/yourorg
#   https://yourorg.visualstudio.com
#   https://your-tfs-server/tfs/DefaultCollection
ADO_ORG=https://dev.azure.com/yourorg

# The team project name (case-sensitive).
ADO_PROJECT=MyProject

# Personal Access Token.
#
# REQUIRED SCOPES:
#   • Work Items  → Read          (required for /api/wip-aging)
#   • Code        → Read          (required for /api/pr-aging and /api/pr-cycle-time)
#
# If you added the PAT before the PR Aging feature was available, you must
# regenerate or edit your PAT to add the Code (Read) scope — otherwise the
# Pull Requests page will return a 401/403 error.
#
# Generate a PAT at:
#   https://dev.azure.com/<yourorg>/_usersSettings/tokens
ADO_PAT=your-personal-access-token-here

# ─── Optional settings ─────────────────────────────────────────────────────────
# ADO REST API version (default: 7.1 — works with Azure DevOps cloud and recent
# on-prem TFS/Azure DevOps Server releases).
# ADO_API_VERSION=7.1

# Port the local proxy listens on (default: 3333).
# PORT=3333

# ─── TLS options (on-premises / corporate CA only) ────────────────────────────
# Trust your organisation's internal/corporate CA certificate.
# ADO_CA_CERT_PATH=/path/to/corporate-ca.pem

# Set to "true" ONLY for local/dev testing against self-signed certs.
# NEVER use in production — disables all TLS certificate validation.
# ADO_INSECURE_TLS=false

# ─── AI explanations (optional) ──────────────────────────────────────────────
# With a key, the Forecast page's "Explain with AI" button asks Claude for a
# structured explanation of an outlier week. Assignee names are never sent.
# Without a key: demo mode shows a sample explanation; live mode hides the button.
# ANTHROPIC_API_KEY=sk-ant-...
# Model override (default: claude-opus-5-5)
# EXPLAIN_MODEL=claude-opus-5-5
